  },
  "devDependencies": {
    "typescript": "5.6.3",
    "tsx": "4.19.2",
    "@types/express": "4.17.21",
    "@types/cors": "2.8.17",
    "@types/node": "22.9.0",
    "@types/swagger-ui-express": "4.1.7",
    "eslint": "9.14.0",
    "typescript-eslint": "8.13.0",
    "@eslint/js": "9.14.0"
  }
